*.py[cod]
.pytest_cache/
.venv/
__pycache__/
analysis/generations.json
analysis/weights.candidate.json

# Trajectory datasets are hundreds of megabytes and regenerable from a seed.
data/trajectories/

# Recorded runs: `acceptance.json` is committed on purpose (see runs/README.md);
# ad-hoc metrics files written alongside it are not.
runs/*.json
!runs/acceptance.json

# Claude Code's local state, including the git worktrees it creates for
# subagents. Committing those would nest a checkout inside the checkout.
.claude/

# Model weights: megabytes per iteration and regenerable from a seed and a
# config, exactly like the trajectory datasets above. `runs/acceptance.json`
# stays committed because it is a *measurement*, not an artefact.
runs/checkpoints/
